# Copy to .env.local and fill in. Never commit real values.

# Supabase, used by the app (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: Google Sheets two-way sync with the Garuda workbook (docs/SYNC.md)
SUPABASE_URL=
# Service role (bypasses RLS). Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Service-account JSON on one line (jq -c . key.json), or base64 of it. The account must be an
# Editor of the Garuda Google Sheet.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Spreadsheet id of "Tracker Tindak Lanjut People Development Garuda" (between /d/ and /edit)
GOOGLE_SHEETS_ID=
# >= 16 chars each, different values (openssl rand -hex 32). SYNC_SECRET: full access (dry run,
# options); SYNC_PING_SECRET: may only trigger a run (Apps Script, pg_cron / DB trigger).
SYNC_SECRET=
SYNC_PING_SECRET=
# Optional: db-wins (default) or sheet-wins
CONFLICT_POLICY=
# (Also optional, server only: SYNC_SHEET_LOCALE=off stops the engine from setting the sheet's
# locale / time zone to Indonesian / Asia/Jakarta; see docs/SYNC.md.)
